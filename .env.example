POSTGRES_DB=shop_agent
POSTGRES_USER=shop_agent
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://shop_agent:change-me@db:5432/shop_agent
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# 本地嵌入模型目录。Docker 中对应挂载后的 /models/bge-small-zh-v1.5。
LOCAL_EMBEDDING_MODEL_PATH=/models/bge-small-zh-v1.5
LOCAL_EMBEDDING_MODEL_ID=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DEVICE=cpu
# 知识库原始文件在 API 容器中的持久化目录，以及单个文件大小上限（MB）。
KNOWLEDGE_UPLOAD_DIR=/uploads
KNOWLEDGE_MAX_UPLOAD_SIZE_MB=20
API_PORT=8000
FRONTEND_PORT=5173
# Adminer 数据库管理界面端口
ADMINER_PORT=8081
