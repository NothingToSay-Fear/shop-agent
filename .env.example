POSTGRES_DB=shop_agent
POSTGRES_USER=shop_agent
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://shop_agent:change-me@db:5432/shop_agent
LLM_API_KEY=
LLM_MODEL=
# openai（含 OpenAI-compatible 服务）、anthropic、google 或 ollama
LLM_PROVIDER=openai
LLM_BASE_URL=
# 本地嵌入模型目录。Docker 中对应挂载后的 /models/bge-small-zh-v1.5。
LOCAL_EMBEDDING_MODEL_PATH=/models/bge-small-zh-v1.5
LOCAL_EMBEDDING_MODEL_ID=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DEVICE=cpu
# 知识库原始文件在 API 容器中的持久化目录，以及单个文件大小上限（MB）。
KNOWLEDGE_UPLOAD_DIR=/uploads
KNOWLEDGE_MAX_UPLOAD_SIZE_MB=20
# 结构化分块中，相邻段落相似度低于此值且当前片段足够长时提前切分。
KNOWLEDGE_CHUNK_SEMANTIC_SIMILARITY_THRESHOLD=0.55
# 联网搜索：首期支持 Tavily。未填写密钥时，联网工具自动禁用，不会发起外部请求。
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
# 本地账号登录令牌的有效天数；到期后需要重新登录。
AUTH_TOKEN_TTL_DAYS=7
# 每轮滚动摘要任务的空闲轮询秒数；仅影响异步摘要 Worker，不影响问答响应。
CONVERSATION_SUMMARY_POLL_SECONDS=1
# Worker 单次领取的租约时长与最大领取次数；Worker 异常退出后，租约到期任务会自动重新排队。
CONVERSATION_SUMMARY_LEASE_SECONDS=300
CONVERSATION_SUMMARY_MAX_ATTEMPTS=3
# 会话短期记忆的总 token 预算及异步压缩阈值；阈值应小于预算。
CONVERSATION_MEMORY_TOKEN_BUDGET=12000
CONVERSATION_MEMORY_COMPACT_THRESHOLD=9600
# 压缩后最多保留的最近消息数量（用户、助手消息合计；超长消息会受 token 预算进一步限制）。
CONVERSATION_MEMORY_RECENT_MESSAGE_LIMIT=6
# “近期关注”长期记忆未指定有效期时的默认保留天数；到期后不再参与回答生成。
USER_MEMORY_FOCUS_DIRECTION_TTL_DAYS=90
# 单个用户可参与回答的长期记忆最大数量，避免长期积累后全量读取。
USER_MEMORY_MAX_ACTIVE_RECORDS=50
API_PORT=8000
FRONTEND_PORT=5173
# Adminer 数据库管理界面端口
ADMINER_PORT=8081
